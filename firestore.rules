rules_version = '2';

// BeVest Firestore security rules (plan section 19).
// Authorization lives here, not in the app UI (plan section 31.9).
// Cloud Functions use the Admin SDK and bypass these rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return hasUserDoc() ? userDoc().role : 'NONE';
    }

    function isActive() {
      return hasUserDoc() && userDoc().active == true;
    }

    function isAdmin() {
      return isActive() && role() == 'ADMIN';
    }

    function isContractor() {
      return isActive() && role() == 'CONTRACTOR';
    }

    function isSso() {
      return isActive() && role() == 'SSO';
    }

    function isDeveloper() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'developer@bevest.com' ||
          request.auth.token.email == 'dev@bevest.com'
        ))
        || (hasUserDoc() && (userDoc().role == 'DEVELOPER' || userDoc().role == 'ADMIN'))
      );
    }

    function myContractorId() {
      return userDoc().contractorId;
    }

    function mySiteId() {
      return userDoc().siteId;
    }

    // ---- users ----
    match /users/{uid} {
      allow get: if isAdmin() || isDeveloper()
                 || (isSignedIn() && request.auth.uid == uid)
                 || (isContractor() && resource.data.contractorId == request.auth.uid);
      allow list: if isAdmin() || isDeveloper()
                  || (isContractor() && request.query.limit <= 200)
                  || (request.query.limit <= 5);
      allow delete: if isDeveloper() || (isAdmin() && resource.data.role != 'DEVELOPER');
      // Developer provisions accounts. Admins can ONLY create accounts for Contractors. Contractors can provision SSO accounts under their own contractorId. Users can initialize their own doc.
      allow create: if isDeveloper()
                 || (isAdmin() && request.resource.data.role == 'CONTRACTOR')
                 || (isSignedIn() && request.auth.uid == uid)
                 || (isContractor() && request.resource.data.role == 'SSO' && request.resource.data.contractorId == request.auth.uid);
      allow update: if isDeveloper()
                    || (isAdmin() && request.resource.data.role != 'DEVELOPER' && resource.data.role != 'DEVELOPER')
                    // A contractor manages their own officers: edit details, move them
                    // to another site, or disable them — but never change who they are
                    // (role, email) or which contractor they belong to.
                    || (isContractor()
                        && resource.data.role == 'SSO'
                        && resource.data.contractorId == request.auth.uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.contractorId == resource.data.contractorId
                        && request.resource.data.email == resource.data.email)
                    // Self-edits (profile, FCM tokens, a contractor's own subscription).
                    // get() with a default: web-created contractor docs have no
                    // contractorId/siteId field, and a missing field would deny the write.
                    || (isSignedIn() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.get('active', true) == resource.data.get('active', true)
                        && request.resource.data.get('contractorId', null) == resource.data.get('contractorId', null)
                        && request.resource.data.get('siteId', null) == resource.data.get('siteId', null))
                    || (isContractor()
                        && resource.data.contractorId == request.auth.uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.contractorId == resource.data.contractorId);
    }

    // ---- workers ----
    match /workers/{workerId} {
      allow read: if isAdmin()
                  || isDeveloper()
                  || resource == null  // let an SSO check whether an auto ID is free
                  || (isContractor() && resource.data.contractorId == request.auth.uid)
                  || (isSso() && resource.data.siteId == mySiteId());
      allow create, update: if isAdmin()
                            || isDeveloper()  // developer vest deletion unlinks workers
                            || (isSso() && request.resource.data.siteId == mySiteId());
      allow delete: if isAdmin();
    }

    // ---- vests ----
    match /vests/{vestId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSso() || isDeveloper() || isSignedIn();
    }

    // ---- subscription payments ----
    match /subscriptionPayments/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isDeveloper();
    }

    // ---- vest assignments (history, never deleted — plan 31.7) ----
    // Exception: when the Developer permanently deletes a vest from the hardware
    // database, its assignment records are removed with it so no worker keeps
    // pointing at a vest that no longer exists.
    match /vestAssignments/{id} {
      allow read: if isAdmin() || isSso() || isContractor() || isDeveloper();
      allow create, update: if isAdmin() || isSso();
      allow delete: if isDeveloper();
    }

    // ---- alerts ----
    match /alerts/{alertId} {
      allow read: if isAdmin()
                  || (isSso() && resource.data.siteId == mySiteId())
                  || (isContractor() && resource.data.contractorId == myContractorId());
      // Production alerts are created by the cloud safety engine or an SSO. The
      // in-app simulator (no IoT hardware yet) may create/remove alerts flagged
      // `simulated == true` — these never affect real safety data.
      allow create: if isAdmin() || isSso()
                    || (isSignedIn() && request.resource.data.simulated == true);
      allow update: if isAdmin()
                    || (isSso() && resource.data.siteId == mySiteId());
      allow delete: if isSignedIn() && resource.data.simulated == true;
    }

    // ---- incidents ----
    match /incidents/{incidentId} {
      allow read: if isAdmin()
                  || (isSso() && resource.data.siteId == mySiteId())
                  || (isContractor() && resource.data.contractorId == myContractorId());
      // Real incidents come from the cloud engine or, while the project has no
      // cloud functions (free plan), from an SSO's app escalating a fall on their own
      // site. Simulated ones (flagged `simulated == true`) may be created/removed by
      // any signed-in user so the app can be demoed before the IoT layer exists.
      allow create: if isAdmin()
                    || (isSso() && request.resource.data.siteId == mySiteId())
                    || (isSignedIn() && request.resource.data.simulated == true);
      allow update: if isAdmin()
                    || (isSso() && resource.data.siteId == mySiteId())
                    || (isContractor() && resource.data.contractorId == myContractorId());
      allow delete: if isSignedIn() && resource.data.simulated == true;
    }

    // ---- projects / sites ----
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
                   || (isContractor() && request.resource.data.contractorId == request.auth.uid);
    }

    // ---- activity log ----
    match /activityLog/{id} {
      allow read: if isAdmin() || isDeveloper();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ---- settings ----
    match /settings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}

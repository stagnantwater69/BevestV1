{
  "rules": {
    ".read": false,
    ".write": false,

    "liveReadings": {
      "$workerId": {
        ".read": "auth != null",

        // Real sensor data: only the vest firmware (custom claim device == true) or an
        // admin. SSO and contractor accounts (role claim from syncUserClaims, or from
        // firmware/tools/sync-role-claims.js on the free plan) run the simulators: they
        // may only create, change or clear nodes flagged `simulated`, so they can never
        // overwrite a real vest's readings.
        ".write": "auth != null && (auth.token.device == true || auth.token.role == 'ADMIN' || ((auth.token.role == 'SSO' || auth.token.role == 'CONTRACTOR') && (!data.exists() || data.child('simulated').val() == true) && (!newData.exists() || newData.child('simulated').val() == true)))",
        ".validate": "newData.hasChildren(['timestamp'])",

        "safetyResponse": {
          // The handshake target: the vest, an officer acknowledging or the safety
          // engine escalating. Contractors only on simulated nodes.
          ".write": "auth != null && (auth.token.role != 'CONTRACTOR' || data.parent().child('simulated').val() == true)",
          ".validate": "newData.isString() && newData.val().matches(/^(NONE|WAITING|ACKNOWLEDGED|EMERGENCY_REQUESTED|NO_RESPONSE|ESCALATED)$/)"
        }
      }
    },

    "vestsLive": {
      "$vestId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.device == true",
        ".validate": "newData.hasChildren(['battery', 'lastSeen'])"
      }
    }
  }
}

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Shown before Compose exists — a plain white ground so cold start has no flash. -->
    <style name="Theme.Bevest.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bevest_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Bevest</item>
    </style>

    <style name="Theme.Bevest" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bevest_window_background</item>
        <item name="android:statusBarColor">@color/bevest_window_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>

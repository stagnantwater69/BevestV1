<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Bevest.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bevest_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Bevest</item>
    </style>

    <style name="Theme.Bevest" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bevest_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
